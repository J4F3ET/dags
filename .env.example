# Plantilla del .env que vive en el host, junto a docker-compose.yaml.
# NUNCA subas el .env real al repo: el repo es público y este archivo lleva secretos.

AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=airflow-homelab:3.3.1

# Clave de cifrado de Connections y Variables. Generar con:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Guarda una copia fuera del servidor: si se pierde, lo cifrado con ella queda irrecuperable.
FERNET_KEY=

# Firma de los tokens JWT entre componentes. Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Descomentar en la Fase 3, al usar operators deferrables:
# COMPOSE_PROFILES=triggerer
